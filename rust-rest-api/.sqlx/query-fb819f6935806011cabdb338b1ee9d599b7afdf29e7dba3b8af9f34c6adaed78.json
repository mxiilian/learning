{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT v.id, v.word, v.definition, v.example_sentence, v.picture_url, v.hint,\n               p.id AS progress_id, p.box_number, p.last_reviewed, p.next_review, p.correct_streak\n        FROM vocab v\n        JOIN user_vocab_progress p ON v.id = p.vocab_id\n        WHERE p.user_id = $1\n        ORDER BY v.word ASC\n        ",
